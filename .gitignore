# ── OS / file-manager junk ────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.directory

# ── Editor / temporary files ──────────────────────────────────────────────
*~
*.swp
*.swo
*.tmp
*.bak
*.orig
*.rej
*.log

# ── Generic caches ────────────────────────────────────────────────────────
.cache/
__pycache__/
*.py[cod]
.venv/
venv/
node_modules/
npm-debug.log*
pnpm-debug.log*

# ── zsh / zimfw runtime state ─────────────────────────────────────────────
# zimfw modules are installed by `zimfw install`, not vendored into git.
.config/zsh/.zim/
# Completion dumps and history are machine-local.
.config/zsh/.zcompdump*
.config/zsh/.zhistory
.config/zsh/.zsh_history

# ── fcitx5 runtime state ──────────────────────────────────────────────────
# Rewritten by fcitx5 on start/exit; not reproducible config.
.config/fcitx5/conf/cached_layouts

# ── Dux Modular Shell runtime state ───────────────────────────────────────
# settings.json and the Catppuccin theme are tracked; these are generated by
# DMS at runtime and would otherwise dirty the repo.
.config/dms/appusage.json
.config/dms/cache.json
.config/dms/clsettings.json
.config/dms/launcher_cache.json
.config/dms/.firstlaunch
.config/dms/.changelog-*
.config/dms/plugins/
.config/dms/profiles/
.config/dms/themes/*
!.config/dms/themes/catppuccin-mocha.json
# DMS regenerates the fcitx5 theme from the active palette.
.local/share/fcitx5/themes/dms/
# DMS writes compositor fragments here; this repo drives niri manually.
.config/niri/dms/

# ── VS Code ──────────────────────────────────────────────────────────────
# Only the user config files live in this repo (linked individually by the
# installer). Everything else under .config/Code is machine-local state.
.config/Code/*
!.config/Code/User/
.config/Code/User/*
!.config/Code/User/settings.json
!.config/Code/User/keybindings.json
